{
  "name": "wexample/symfony-shop-ds",
  "version": "2.1.1",
  "type": "library",
  "license": "MIT",
  "description": "The interface of symfony-shop: a shop, its cart, the purchase tunnel, the buyer's orders and their administration",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyShopDs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyShopDs\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=17.0.0",
    "wexample/symfony-loader": ">=23.2.0",
    "wexample/symfony-design-system": ">=37.0.0",
    "wexample/symfony-api": ">=14.0.0",
    "wexample/symfony-forms": ">=13.0.0",
    "wexample/symfony-money": ">=7.0.0",
    "wexample/symfony-geo": ">=7.0.0",
    "wexample/symfony-tunnels": ">=11.0.0",
    "wexample/symfony-shop": ">=4.0.0",
    "wexample/symfony-payment": ">=4.0.0",
    "wexample/symfony-payment-ds": ">=3.0.0",
    "wexample/symfony-user": ">=13.0.0",
    "wexample/symfony-user-ds": ">=5.1.0",
    "wexample/symfony-mail": ">=2.0.0",
    "wexample/symfony-geo-ds": ">=3.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}