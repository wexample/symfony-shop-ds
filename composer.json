{
  "name": "wexample/symfony-shop-ds",
  "version": "3.0.12",
  "type": "library",
  "license": "MIT",
  "description": "The interface of symfony-shop: a shop, its cart, the purchase tunnel, the buyer's orders and their administration",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyShopDs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyShopDs\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=19.1.0",
    "wexample/symfony-loader": ">=27.0.0",
    "wexample/symfony-design-system": ">=42.0.0",
    "wexample/symfony-api": ">=16.0.0",
    "wexample/symfony-forms": ">=14.0.2",
    "wexample/symfony-money": ">=8.0.0",
    "wexample/symfony-geo": ">=8.0.2",
    "wexample/symfony-tunnels": ">=11.0.5",
    "wexample/symfony-shop": ">=5.0.1",
    "wexample/symfony-payment": ">=5.0.0",
    "wexample/symfony-payment-ds": ">=3.0.5",
    "wexample/symfony-user": ">=19.0.0",
    "wexample/symfony-user-ds": ">=7.3.0",
    "wexample/symfony-mail": ">=4.0.0",
    "wexample/symfony-geo-ds": ">=3.0.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}