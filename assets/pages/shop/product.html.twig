{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}
{#- A page under another: the way back to it, its actions beside, on top. -#}
{%- set page_trail = 'back' -%}
{%- set page_title = product.title -%}

{#- A product: what it is, what it costs, what is left of each choice, and
    the form putting it in the cart — none when nothing is left. -#}
{%- block page_body -%}
    {%- set common = 'WexampleSymfonyShopDsBundle.common.cart::' -%}
    {%- if product.description -%}
        <p class="lead">{{ product.description }}</p>
    {%- endif -%}

    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/tag') }}</span>
            <span class="block--title-label">{{ product.title }}</span>
            <span class="block--title-trailing">{{ product.freeAmount ? '@page::free_amount' | trans : product.calcPriceFinal()|price(product.currencyCode, app.request.locale) }}</span>
        </div>
        <div class="block--body stack--vertical">
            {%- if left|length -%}
                {{ properties(left|map(line => {
                    key: [line.schedule ? (line.schedule.label ?: line.schedule.dateStart|date('Y-m-d H:i')) : null, line.variation ? line.variation.name ~ ' — ' ~ line.variation.value : null]|filter(v => v)|join(' · ') ?: product.title,
                    value: line.remaining == 0 ? (common ~ 'sold_out') | trans : (common ~ 'left') | trans({ '%count%': line.remaining }),
                })) }}
            {%- endif -%}
            {%- if sold_out -%}
                {{ message_warning((common ~ 'sold_out') | trans, '@page::sold_out' | trans) }}
            {%- else -%}
                {{ cart_add(product) }}
            {%- endif -%}
        </div>
    </section>
{%- endblock -%}
