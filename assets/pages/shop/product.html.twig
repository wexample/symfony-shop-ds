{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}
{#- A page under another: the way back to it, its actions beside, on top. -#}
{%- set page_trail = 'back' -%}
{%- set page_title = product.title -%}
{#- Described for the engines with its offers (ProductSchemaOrgNormalizer). -#}
{%- set document_subject = product -%}

{#- A product: what it is, what it costs, what each choice costs where it
    changes the price and what is left of it, and the form putting it in the
    cart — none when nothing is left. -#}
{%- block page_body -%}
    {%- set common = 'WexampleSymfonyShopDsBundle.common.cart::' -%}
    {%- set price = product.freeAmount ? null : product.calcPriceFinal() -%}
    {%- set lines = offers|filter(offer => offer.remaining is not null or offer.priceFinal != price) -%}
    {%- if product.description -%}
        <p class="lead">{{ product.description }}</p>
    {%- endif -%}

    <section class="block block--card">
        <div class="block--title">
            <span class="block--title-leading">{{ icon('ph:bold/tag') }}</span>
            <span class="block--title-label">{{ product.title }}</span>
            <span class="block--title-trailing">{{ product.freeAmount ? '@page::free_amount' | trans : product.calcPriceFinal()|price(product.currencyCode, app.request.locale) }}</span>
        </div>
        <div class="block--body stack--vertical">
            {%- if lines|length -%}
                {{ properties(lines|map(offer => {
                    key: [offer.schedule ? (offer.schedule.label ?: offer.schedule.dateStart|date('Y-m-d H:i')) : null, offer.variation ? offer.variation.name ~ ' — ' ~ offer.variation.value : null]|filter(v => v)|join(' · ') ?: product.title,
                    value: [
                        offer.priceFinal != price ? offer.priceFinal|price(offer.currencyCode, app.request.locale) : null,
                        offer.remaining is null ? null : (offer.remaining == 0 ? (common ~ 'sold_out') | trans : (common ~ 'left') | trans({ '%count%': offer.remaining })),
                    ]|filter(v => v)|join(' · '),
                })) }}
            {%- endif -%}
            {%- if sold_out -%}
                {{ message_warning((common ~ 'sold_out') | trans, '@page::sold_out' | trans) }}
            {%- else -%}
                {{ cart_add(product) }}
            {%- endif -%}
        </div>
    </section>
{%- endblock -%}
