{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_title_actions -%}
    {{ button_link('ph:bold/shopping-cart', '@page::cart' | trans, path('cart_index')) }}
{%- endblock -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>
    {%- if products|length -%}
        <div class="grid grid--3">
            {%- for product in products -%}
                {#- Opened beside the list, in a modal: put in the cart, the list is
                    still there. A full page still, opened in a new tab. -#}
                {#- Its words in the reader's language (#[Translatable]). -#}
                {%- set words = translated(product) -%}
                {%- set card -%}
                    <span class="block--link-title">{{ words.title }}</span>
                    {%- if words.description -%}
                        <span class="block--link-description">{{ words.description|length > 120 ? words.description|slice(0, 119) ~ '…' : words.description }}</span>
                    {%- endif -%}
                    <span class="cluster">
                        <strong>{{ product.freeAmount ? '@page::free_amount' | trans : product.calcPriceFinal()|price(product.currencyCode, app.request.locale) }}</strong>
                        {%- if sold_out[loop.index0] -%}
                            {{ marker('disabled', 'WexampleSymfonyShopDsBundle.common.cart::sold_out' | trans, { compact: true }) }}
                        {%- endif -%}
                    </span>
                {%- endset -%}
                {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/button-target', {
                    icon: null,
                    label: '',
                    html: card,
                    options: { href: path('shop_product', { slug: product.slug }), target: 'modal', link: true, class: 'block block--padded block--link' },
                }) }}
            {%- endfor -%}
        </div>
    {%- else -%}
        <p class="fallback">{{ '@page::empty' | trans }}</p>
    {%- endif -%}
{%- endblock -%}
