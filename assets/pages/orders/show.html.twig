{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}
{#- A page under another: the way back to it, its actions beside, on top. -#}
{%- set page_trail = 'back' -%}

{%- block page_title_actions -%}
    {%- if order.payment -%}
        {{ button_link('ph:bold/credit-card', '@page::payment' | trans, path('payments_show', { id: order.payment.id })) }}
        {%- if order.payment.status.paid -%}
            {{ button_target('ph:bold/file-text', '@page::receipt' | trans, path('payments_receipt', { id: order.payment.id }), 'modal') }}
        {%- endif -%}
    {%- endif -%}
{%- endblock -%}

{#- An order in full: when, where it went, what it held, how it was paid. -#}
{%- block page_body -%}
    {%- set common = 'WexampleSymfonyShopDsBundle.common.cart::' -%}
    {%- set tones = { paid: 'success', fulfilled: 'success', waiting_payment: 'info', awaiting_validation: 'warning', canceled: 'neutral' } -%}
    <section class="block block--padded">
        {{ properties([
            { key: '@page::field.status' | trans, value: marker(tones[order.status.value], (common ~ 'status.' ~ order.status.value) | trans, { compact: true }), html: true },
            { key: '@page::field.date' | trans, value: date_display(order.datePaid ?? order.dateUpdated, 'date_time_short'), html: true },
            { key: '@page::field.billing' | trans, value: order.billingAddress ? order.billingAddress.toLines|join('<br>') : '—', html: true },
            { key: '@page::field.shipping' | trans, value: order.shippingAddress ? order.shippingAddress.toLines|join('<br>') : '—', html: true },
        ], { columns: true }) }}
    </section>

    {{ cart_summary({ state: order_state }) }}
{%- endblock -%}
