{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{#- What the account ordered, the latest first: each order opens in full. -#}
{%- block page_body -%}
    {%- set common = 'WexampleSymfonyShopDsBundle.common.cart::' -%}
    {%- if orders is empty -%}
        <p class="fallback">{{ '@page::empty' | trans }}</p>
        <div class="cluster">
            {{ button_link('ph:bold/storefront', (common ~ 'shop') | trans, path('shop_index'), { class: 'button--invert' }) }}
        </div>
    {%- else -%}
        {%- set tones = { paid: 'success', fulfilled: 'success', waiting_payment: 'info', awaiting_validation: 'warning', canceled: 'neutral' } -%}
        {{ data_table([
            { key: 'date', label: '@page::column.date' | trans, cell: 'html' },
            { key: 'items', label: '@page::column.items' | trans },
            { key: 'total', label: (common ~ 'total') | trans, align: 'end' },
            { key: 'status', label: '@page::column.status' | trans, cell: 'html' },
        ], orders|map(order => order|merge({
            date: date_display(order.date, 'date_time_short'),
            status: marker(tones[order.status], (common ~ 'status.' ~ order.status) | trans, { compact: true }),
        })), { row_link: { key: 'href' } }) }}
    {%- endif -%}
{%- endblock -%}
